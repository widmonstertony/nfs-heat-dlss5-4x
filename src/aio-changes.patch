+// Load the private caller bridge below the Win32 LoadLibrary layer.  Proxy
+// upscalers commonly intercept every LoadLibrary("nvngx.dll") request and
+// return themselves, but the DLSS-NR snippet also validates that its caller's
+// real module filename contains "nvngx.dll".  Calling ntdll's loader directly
+// preserves that required identity without disabling the proxy globally.
+struct LdrUnicodeString
+{
+    USHORT Length;
+    USHORT MaximumLength;
+    PWSTR Buffer;
+};
+
+struct LdrAnsiString
+{
+    USHORT Length;
+    USHORT MaximumLength;
+    PCHAR Buffer;
+};
+
+using LdrLoadDllFn = LONG (NTAPI *)(PWSTR, PULONG, const LdrUnicodeString *, PHANDLE);
+using LdrGetProcedureAddressFn = LONG (NTAPI *)(HMODULE, const LdrAnsiString *, USHORT, PVOID *);
+
+static HMODULE LoadPrivateBridge(const wchar_t *path)
+{
+    if (path == nullptr || *path == L'\0') return nullptr;
+    HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+    auto ldr_load_dll = ntdll != nullptr ?
+        reinterpret_cast<LdrLoadDllFn>(GetProcAddress(ntdll, "LdrLoadDll")) : nullptr;
+    if (ldr_load_dll == nullptr)
+    {
+        Log("private bridge loader unavailable: ntdll=%p error=%lu", ntdll, GetLastError());
+        return nullptr;
+    }
+
+    const size_t length = wcslen(path);
+    if (length > (USHRT_MAX / sizeof(wchar_t)) - 1) return nullptr;
+    LdrUnicodeString name = {
+        static_cast<USHORT>(length * sizeof(wchar_t)),
+        static_cast<USHORT>((length + 1) * sizeof(wchar_t)),
+        const_cast<PWSTR>(path)
+    };
+    HMODULE module = nullptr;
+    const LONG status = ldr_load_dll(nullptr, nullptr, &name, reinterpret_cast<PHANDLE>(&module));
+    wchar_t loaded_path[MAX_PATH] = {};
+    if (module != nullptr) GetModuleFileNameW(module, loaded_path, MAX_PATH);
+    Log("private bridge LdrLoadDll(%ls) -> %p status=0x%08lX loaded=%ls", path, module,
+        static_cast<unsigned long>(status), loaded_path);
+    return status >= 0 ? module : nullptr;
+}
+
+// Resolve exports below the Win32 GetProcAddress layer for the same reason
+// that LoadPrivateBridge uses LdrLoadDll: proxy upscalers may replace the
+// exports returned for nvngx.dll even when the real module was loaded.
+static FARPROC ResolvePrivateBridgeExport(HMODULE module, const char *name)
+{
+    if (module == nullptr || name == nullptr || *name == '\0') return nullptr;
+    HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+    auto ldr_get_procedure_address = ntdll != nullptr ?
+        reinterpret_cast<LdrGetProcedureAddressFn>(GetProcAddress(ntdll, "LdrGetProcedureAddress")) : nullptr;
+    if (ldr_get_procedure_address == nullptr)
+    {
+        Log("private bridge resolver unavailable: ntdll=%p error=%lu", ntdll, GetLastError());
+        return nullptr;
+    }
+
+    const size_t length = strlen(name);
+    if (length > USHRT_MAX) return nullptr;
+    LdrAnsiString export_name = {
+        static_cast<USHORT>(length),
+        static_cast<USHORT>(length + 1),
+        const_cast<PCHAR>(name)
+    };
+    PVOID address = nullptr;
+    const LONG status = ldr_get_procedure_address(module, &export_name, 0, &address);
+    Log("private bridge LdrGetProcedureAddress(%s) -> %p status=0x%08lX", name, address,
+        static_cast<unsigned long>(status));
+    return status >= 0 ? reinterpret_cast<FARPROC>(address) : nullptr;
+}
